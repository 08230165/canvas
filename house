import tkinter as tk

root = tk.Tk()
root.title("Colorful House")

canvas = tk.Canvas(root, width=600, height=450, bg="skyblue")
canvas.pack()

# Grass
canvas.create_rectangle(
    0, 330, 600, 450,
    fill="lightgreen",
    outline="lightgreen"
)

# House body
canvas.create_rectangle(
    150, 180, 450, 350,
    fill="lightyellow",
    outline="black",
    width=3
)

# Roof
canvas.create_polygon(
    120, 180,
    300, 70,
    480, 180,
    fill="tomato",
    outline="black",
    width=3
)

# Door
canvas.create_rectangle(
    270, 250, 340, 350,
    fill="brown",
    outline="black",
    width=2
)

# Door handle
canvas.create_oval(
    325, 295, 335, 305,
    fill="gold",
    outline="black"
)

# Left window
canvas.create_rectangle(
    180, 220, 245, 275,
    fill="lightblue",
    outline="black",
    width=2
)

# Window lines
canvas.create_line(212, 220, 212, 275, width=2)
canvas.create_line(180, 247, 245, 247, width=2)

# Right window
canvas.create_rectangle(
    365, 220, 430, 275,
    fill="lightblue",
    outline="black",
    width=2
)

canvas.create_line(397, 220, 397, 275, width=2)
canvas.create_line(365, 247, 430, 247, width=2)

# Sun
canvas.create_oval(
    40, 40, 110, 110,
    fill="yellow",
    outline="orange",
    width=3
)

# Chimney
canvas.create_rectangle(
    370, 95, 410, 155,
    fill="gray",
    outline="black"
)

# House title
canvas.create_text(
    300, 400,
    text="My Colorful House",
    font=("Arial", 20, "bold"),
    fill="darkblue"
)

root.mainloop()