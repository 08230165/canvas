import tkinter as tk

root = tk.Tk()
root.title("Colorful House")

canvas = tk.Canvas(root, width=600, height=450, bg="skyblue")
canvas.pack()

# Grass
canvas.create_rectangle(
    0, 330, 600, 450,
    fill="lightgreen",
    outline="lightgreen"
)

# ---------------- MAIN HOUSE ----------------

# House body
canvas.create_rectangle(
    180, 180, 470, 350,
    fill="lightyellow",
    outline="black",
    width=3
)

# Roof
canvas.create_polygon(
    150, 180,
    325, 70,
    500, 180,
    fill="tomato",
    outline="black",
    width=3
)

# Door
canvas.create_rectangle(
    290, 250, 360, 350,
    fill="brown",
    outline="black",
    width=2
)

# Door handle
canvas.create_oval(
    345, 295, 355, 305,
    fill="gold",
    outline="black"
)

# Left window
canvas.create_rectangle(
    200, 220, 260, 275,
    fill="lightblue",
    outline="black",
    width=2
)

canvas.create_line(230, 220, 230, 275, width=2)
canvas.create_line(200, 247, 260, 247, width=2)

# Right window
canvas.create_rectangle(
    390, 220, 450, 275,
    fill="lightblue",
    outline="black",
    width=2
)

canvas.create_line(420, 220, 420, 275, width=2)
canvas.create_line(390, 247, 450, 247, width=2)

# Chimney
canvas.create_rectangle(
    390, 100, 430, 155,
    fill="gray",
    outline="black"
)

# ---------------- DOG HOUSE ----------------

# Dog house body
canvas.create_rectangle(
    40, 285, 145, 350,
    fill="orange",
    outline="black",
    width=2
)

# Dog house roof
canvas.create_polygon(
    25, 285,
    92, 235,
    160, 285,
    fill="darkred",
    outline="black",
    width=2
)

# Dog house entrance
canvas.create_oval(
    60, 300, 120, 350,
    fill="black",
    outline="black"
)

# Dog house name
canvas.create_text(
    92, 275,
    text="DOG",
    font=("Arial", 11, "bold"),
    fill="white"
)

# ---------------- SUN ----------------

canvas.create_oval(
    40, 40, 110, 110,
    fill="yellow",
    outline="orange",
    width=3
)

# Title
canvas.create_text(
    300, 405,
    text="My Colorful House",
    font=("Arial", 20, "bold"),
    fill="darkblue"
)

root.mainloop()
